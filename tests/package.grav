// SocketsPackage: its settings and sockets:serve.
import "std"
import "apogee-config"
import "apogee-package"
import "../src/all.grav"
use apogee.*

test "the package connects itself" {
    let ps = Packages.discover()
    assertEq(ps[0].name(), "sockets")
    Packages.applyDefaults(ps)
    assertEq(Config.getInt("sockets.port", 0), 6001 as long)
    assertEq(ps[0].commands().size(), 1)
    assert(ps[0].commands()[0] is SocketsServeCommand)
}
